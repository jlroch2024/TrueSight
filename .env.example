# Copy this file to .env in the repository root, and fill in what your story needs.
# Git ignores .env, so your keys stay on your computer. Write values without quotes.

# Database. These defaults match docker-compose.yml, so you can leave them as they are.
# DATABASE_URL=jdbc:postgresql://localhost:5530/truesight
# DATABASE_USERNAME=truesight
# DATABASE_PASSWORD=truesight

# Signs log-in tokens (Sign Up and Log In). Any random text of at least 32 characters.
JWT_SECRET=

# Gemini (Find Suppliers and Customers with AI). Get a key at https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# The SEC requires every request to say who is making it (Get Each Company's Latest Annual Report).
SEC_USER_AGENT=TrueSight contact@truesight.com

# Logo.dev (Readable Supply Chain Graph): the company logos on the graph. Get a publishable key (pk_...) at
# https://www.logo.dev. Without one, the graph shows each company's first letter instead.
LOGO_DEV_TOKEN=
# Logo.dev's secret key (sk_...), from the same account: finds the website of companies without a ticker, so the graph
# can show their logos too. It stays on the server. Without it, those companies show their first letter.
LOGO_DEV_SECRET_KEY=

# The emails that get the Analyst role (Analyst Role): comma-separated, any capitalisation. Applied when an account is
# created and again every time the app starts. Everybody else is a Portfolio Manager. Leave it empty for no Analysts.
# It is not a secret: on the live site it is a plain Cloud Run variable.
ANALYST_EMAILS=
